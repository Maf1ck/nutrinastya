PORT=3001
# Admin panel login. Use a long unique password (12+ chars) in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Two-factor auth (Google Authenticator). Generate with: pnpm --filter konditerska-backend totp:setup
ADMIN_TOTP_SECRET=
# Long random string used to sign admin session tokens
SESSION_SECRET=change-me-to-a-long-random-string
# Origin of the frontend (for CORS in development)
CORS_ORIGIN=http://localhost:5173

# Order notifications to Telegram (optional): create a bot via @BotFather,
# write to it, then put its token and your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Number of reverse proxies in front of the app (nginx/Caddy = 1). Keep 0 if exposed directly.
TRUST_PROXY=0
